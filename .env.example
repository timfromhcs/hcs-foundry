# Copy to .env and adjust. All values are optional.

# Where the service stores its database, artifacts, datasets and logs.
FOUNDRY_DATA_DIR=E:\AILOCALTRAIN\data

# Loopback only. Do not set a LAN address unless you also set FOUNDRY_ALLOW_LAN=1.
FOUNDRY_HOST=127.0.0.1
FOUNDRY_PORT=8770
FOUNDRY_ALLOW_LAN=0

# Extra folders to scan for .gguf files (semicolon separated).
# FOUNDRY_MODEL_ROOTS=D:\aimodels;%USERPROFILE%\.lmstudio\models

# Extra folders allowed as import sources (semicolon separated).
# FOUNDRY_IMPORT_ROOTS=%USERPROFILE%\.claude\projects;%USERPROFILE%\.codex\sessions

# Extra browser origins allowed to pair (semicolon separated).
# FOUNDRY_UI_ORIGINS=http://127.0.0.1:5173

# Explicit llama-server binary.
# FOUNDRY_LLAMA_SERVER=C:\llama.cpp\build\bin\llama-server.exe

FOUNDRY_LOG_LEVEL=INFO

# There is no telemetry. This flag exists only to make that explicit.
FOUNDRY_TELEMETRY=0
